// LALRPOP Grammar for a more expressive BeatScript V12

use crate::lang::{self, TopLevelItem, SectionItem, TrackItem, Value};
use std::collections::HashMap;

grammar;

pub Project: lang::Project = {
    <items:TopLevelItem*> => {
        let mut proj = lang::Project::default();
        for item in items {
            match item {
                TopLevelItem::Composition(c) => proj.composition = Some(c),
                TopLevelItem::Timeline(t) => proj.timeline = t,
                TopLevelItem::Section(s) => proj.sections.push(s),
                TopLevelItem::Synth(s) => proj.synths.push(s),
                TopLevelItem::FxChain(f) => proj.fx_chains.push(f),
            }
        }
        proj
    }
};

TopLevelItem: TopLevelItem = {
    <c:Composition> => TopLevelItem::Composition(c),
    <t:Timeline> => TopLevelItem::Timeline(t),
    <s:Section> => TopLevelItem::Section(s),
    <sy:Synth> => TopLevelItem::Synth(sy),
    <f:FxChain> => TopLevelItem::FxChain(f),
};

Composition: lang::Composition = {
    "composition" "{" <items:CompositionItem*> "}" => {
        let mut comp = lang::Composition::default();
        for (k, v) in items {
            match k.as_str() {
                "title" => if let Value::String(s) = v { comp.title = s },
                "artist" => if let Value::String(s) = v { comp.artist = s },
                "key" => if let Value::String(s) = v { comp.key = s },
                "bpm" => if let Value::Integer(i) = v { comp.bpm = i as u32 },
                _ => {}
            }
        }
        comp
    }
};

CompositionItem: (String, Value) = {
    <k:Identifier> ":" <v:Literal> Separator? => (k, v),
};

Timeline: Vec<String> = {
    "timeline" ":" "[" <v:IdentifierList> "]" => v,
};

IdentifierList: Vec<String> = {
    <v:(<Identifier> Separator?)*> => v
};

Synth: lang::Synth = {
    "synth" <name:Identifier> "{" <items:SynthItem*> "}" => {
        let mut synth = lang::Synth { name, ..Default::default() };
        for (k, v) in items {
            match k.as_str() {
                "type" => if let Value::String(s) = v { synth.synth_type = s },
                _ => { synth.parameters.insert(k, v); }
            }
        }
        synth
    }
};

SynthItem: (String, Value) = {
    <k:Identifier> ":" <v:Literal> Separator? => (k, v),
};

FxChain: lang::FxChain = {
    "fx_chain" <name:Identifier> "{" <effects:Effect*> "}" => lang::FxChain { name, effects },
};

Effect: lang::Effect = {
    <t:Identifier> "{" <items:EffectItem*> "}" => {
        let mut eff = lang::Effect { effect_type: t, ..Default::default() };
        for (k, v) in items {
            eff.parameters.insert(k, v);
        }
        eff
    }
};

EffectItem: (String, Value) = {
    <k:Identifier> ":" <v:Literal> Separator? => (k, v),
};

Section: lang::Section = {
    "section" <name:Identifier> "{" <items:SectionItem*> "}" => {
        let mut sec = lang::Section { name, ..Default::default() };
        for item in items {
            match item {
                SectionItem::Length(l) => sec.length_bars = l,
                SectionItem::Track(t) => sec.tracks.push(t),
            }
        }
        sec
    }
};

SectionItem: SectionItem = {
    "length" ":" <l:Integer> Separator? => SectionItem::Length(l as u32),
    <t:Track> Separator? => SectionItem::Track(t),
};

Track: lang::Track = {
    "track" <name:Identifier> "{" <items:TrackItem*> "}" => {
        let mut track = lang::Track { name, ..Default::default() };
        for item in items {
            match item {
                TrackItem::Instrument(i) => track.instrument = i,
                TrackItem::Pattern(p) => track.pattern = p,
                TrackItem::Send(s) => track.sends.push(s),
            }
        }
        track
    }
};

TrackItem: TrackItem = {
    "instrument" ":" <i:Identifier> Separator? => TrackItem::Instrument(i),
    "pattern" ":" <p:Pattern> Separator? => TrackItem::Pattern(p),
    "send" ":" "{" <s:SendSubItem*> "}" Separator? => {
        let mut send = lang::SendEffect { to: String::new(), amount: 0.0 };
        for (k, v) in s {
            match k.as_str() {
                "to" => if let Value::String(s) = v { send.to = s },
                "amount" => if let Value::Float(f) = v { send.amount = f } else if let Value::Integer(i) = v { send.amount = i as f32 },
                _ => {}
            }
        }
        TrackItem::Send(send)
    },
};

SendSubItem: (String, Value) = {
    <k:Identifier> ":" <v:Literal> Separator? => (k, v),
};

Pattern: lang::Pattern = {
    "euclidean" "(" <h:Integer> "," <s:Integer> <r:("," Integer)?> ")" => {
        let rotate = r.map(|(_, val)| val as u8).unwrap_or(0);
        lang::Pattern::Euclidean { hits: h as u8, steps: s as u8, rotate }
    },
    <s:String> => {
        lang::Pattern::Binary(s)
    },
    "[" <v:PatternStepList> "]" => lang::Pattern::Notes(v.into_iter().enumerate().flat_map(|(i, steps)| {
        steps.into_iter().map(move |notes| lang::NoteEvent {
            time_steps: i as u32,
            notes,
            velocity: 100,
            duration_steps: 1,
        })
    }).collect()),
};

PatternStepList: Vec<Vec<Vec<String>>> = {
    <v:(<PatternStep> Separator?)*> => v
};

PatternStep: Vec<Vec<String>> = {
    "_" => vec![],
    <n:Identifier> => vec![vec![n]],
    "[" <v:IdentifierList> "]" => vec![v],
};

Literal: lang::Value = {
    <f:Float> => Value::Float(f),
    <i:Integer> => Value::Integer(i),
    <s:String> => Value::String(s),
    <id:Identifier> => Value::String(id),
    "{" <items:CompositionItem*> "}" => {
        let mut map = HashMap::new();
        for (k, v) in items {
            map.insert(k, v);
        }
        Value::Object(map)
    }
};

// --- Terminals ---

Identifier: String = <s:r"[a-zA-Z_][a-zA-Z0-9_]*"> => s.to_string();
String: String = <s:r#""([^"\\]|\\.)*""#> => s[1..s.len()-1].to_string();
Integer: i64 = <s:r"-?[0-9]+"> => s.parse().unwrap();
Float: f32 = <s:r"-?[0-9]+\.[0-9]+"> => s.parse().unwrap();

Separator: () = {
    "," => (),
    ";" => (),
};
